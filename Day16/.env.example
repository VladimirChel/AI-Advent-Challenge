# MQTT broker settings
WB_MQTT_HOST=127.0.0.1
WB_MQTT_PORT=1883
WB_MQTT_USERNAME=
WB_MQTT_PASSWORD=
WB_MQTT_CLIENT_ID=wb-temperature-mcp
WB_MQTT_KEEPALIVE=60

# Value topics to subscribe to.
# Format: JSON array or comma-separated list.
WB_MQTT_TOPICS=["wb-msw-v4_12/Temperature","wb-msw-v4_13/Temperature"]

# Human-friendly aliases for sensor_id or topic.
# Keys can be:
# - sensor_id: "wb-msw-v4_12/Temperature"
# - full MQTT topic: "/devices/wb-msw-v4_12/controls/Temperature"
WB_MQTT_ALIASES={"wb-msw-v4_12/Temperature":"Kitchen","wb-msw-v4_13/Temperature":"Boiler room"}
