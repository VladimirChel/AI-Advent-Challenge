# =========================
# REQUIRED
# =========================

# OpenAI-compatible LLM API key.
# For local servers like LM Studio or Ollama, any non-empty placeholder usually works.
# Legacy names PROXYAPI_API_KEY / PROXYAPI_BASE_URL are also supported.
LLM_API_KEY=your_api_key_here

# OpenAI-compatible provider base URL.
# ProxyAPI example:
# LLM_BASE_URL=https://openai.api.proxyapi.ru/v1
# LM Studio example:
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# Ollama example:
# LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_BASE_URL=https://openai.api.proxyapi.ru/v1
DEFAULT_LLM_PROVIDER=default
LLM_PROVIDERS=

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/llm_db
AUTH_SECRET_KEY=change_me_to_a_long_random_secret

# =========================
# APP SETTINGS
# =========================

APP_HOST=0.0.0.0
APP_PORT=8000
STATELESS_MODE=false
AUTH_ENABLED=true
MEMORY_ENABLED=true

# Default model identifier for the configured provider or local server.
DEFAULT_MODEL=gpt-4o-mini

REQUEST_TIMEOUT_SECONDS=60
AUTH_TOKEN_TTL_SECONDS=86400
MCP_ENABLED=false
MCP_SERVER_SCRIPT=../Day16/server.py
MCP_SERVER_SCRIPTS=["../MCP/mqtt_collect/server.py","../MCP/mqtt_summary/server.py","../MCP/telegram_sender/server.py","../MCP/weather_forecast/server.py"]
MCP_WAIT_AFTER_START_SECONDS=0
MCP_MAX_TOOL_ROUNDTRIPS=4
MCP_TOOL_CALL_TIMEOUT_SECONDS=20
RAG_ENABLED=false
RAG_STRATEGY=structure
RAG_INDEX_FILE=
RAG_METADATA_FILE=
RAG_EMBED_MODEL=bge-m3
RAG_OLLAMA_URL=http://localhost:11434
RAG_MAX_CHUNKS=5
RAG_MIN_RELEVANCE_SCORE=0.75
RAG_DENSE_SEARCH_ENABLED=true
RAG_LEXICAL_RERANK_ENABLED=true
RAG_LEXICAL_FALLBACK_ENABLED=true

# Limits
MAX_TEMPERATURE=1.2
MAX_MAX_TOKENS=4000

# History
HISTORY_LIMIT=20
MAX_HISTORY_LIMIT=100

# Logs
LOG_DIR=logs
LOG_LEVEL=INFO
INVARIANTS_FILE=docs/assistant_invariants.json

# =========================
# SUMMARY
# =========================

SUMMARY_TRIGGER_MESSAGES=24
SUMMARY_KEEP_LAST_MESSAGES=10
SUMMARY_MAX_INPUT_MESSAGES=100
SUMMARY_MAX_TOKENS=500
SUMMARY_MODEL=

# =========================
# RETRIEVAL
# =========================

RETRIEVAL_ENABLED=true
RETRIEVAL_LIMIT=6
RETRIEVAL_MIN_QUERY_CHARS=8
RETRIEVAL_CANDIDATE_POOL=80
RETRIEVAL_MAX_CONTENT_CHARS=1200
RETRIEVAL_MIN_SCORE=0.08
RETRIEVAL_USE_TRIGRAM=true

# =========================
# STICKY FACTS
# =========================

STICKY_FACTS_ENABLED=true
STICKY_FACTS_TRIGGER_MESSAGES=6
STICKY_FACTS_MAX_INPUT_MESSAGES=24
STICKY_FACTS_MAX_TOKENS=350
STICKY_FACTS_MODEL=
STICKY_FACTS_MAX_ITEMS=20

# =========================
# TASKS
# =========================

TASK_MEMORY_ENABLED=true
TASK_AUTO_ID_FOR_RAG_CHAT=true
TASK_SHOW_TRANSITIONS=true
TASK_REQUIRE_PLAN_APPROVAL=true
TASK_GOAL_MAX_CHARS=1000
TASK_LAST_USER_MESSAGE_MAX_CHARS=1000
TASK_LAST_RESPONSE_PREVIEW_CHARS=500
TASK_CLARIFIED_POINTS_LIMIT=12
TASK_CONSTRAINTS_LIMIT=10
TASK_FIXED_TERMS_LIMIT=12
TASK_OPEN_QUESTIONS_LIMIT=5
