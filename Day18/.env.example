APP_NAME=day18-scheduled-agent
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8018
DEBUG=false
LOG_LEVEL=INFO

PROXYAPI_API_KEY=
PROXYAPI_BASE_URL=https://openai.api.proxyapi.ru/v1
DEFAULT_MODEL=openai/gpt-4o-mini
REQUEST_TIMEOUT_SECONDS=60

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/day18_agent
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

MCP_SERVER_SCRIPT=../Day16/server.py
MCP_WAIT_AFTER_START_SECONDS=3
MCP_TOOL_CALL_TIMEOUT_SECONDS=20

COLLECT_INTERVAL_SECONDS=300
AGGREGATE_INTERVAL_SECONDS=900
SUMMARY_INTERVAL_SECONDS=3600
SUMMARY_LOOKBACK_HOURS=1
