# =========================
# Required
# =========================
PROXYAPI_API_KEY=your_api_key_here
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# =========================
# ProxyAPI / OpenAI
# =========================
PROXYAPI_BASE_URL=https://openai.api.proxyapi.ru/v1

# =========================
# App
# =========================
APP_HOST=0.0.0.0
APP_PORT=8000

# =========================
# LLM settings
# =========================
DEFAULT_MODEL=openai/gpt-4o-mini
REQUEST_TIMEOUT_SECONDS=60
MAX_TEMPERATURE=1.2
MAX_MAX_TOKENS=4000

# =========================
# Memory / History
# =========================
DEFAULT_HISTORY_LIMIT=20
MAX_HISTORY_LIMIT=100

# =========================
# Logging
# =========================
LOG_DIR=logs

# =========================
# Summarization (memory compression)
# =========================
SUMMARY_TRIGGER_MESSAGES=24
SUMMARY_KEEP_LAST_MESSAGES=10
SUMMARY_MAX_INPUT_MESSAGES=100
SUMMARY_MAX_TOKENS=500
SUMMARY_MODEL=